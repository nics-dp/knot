{:paths ["src/clj" "src/cljc" "resources"]

 :deps {org.clojure/clojure                      {:mvn/version "1.12.6"}
        http-kit/http-kit                        {:mvn/version "2.8.1"}
        metosin/reitit-ring                      {:mvn/version "0.11.0"}
        metosin/reitit-middleware                {:mvn/version "0.11.0"}
        metosin/muuntaja                         {:mvn/version "0.6.12"}
        metosin/malli                            {:mvn/version "0.20.3"}
        integrant/integrant                      {:mvn/version "1.0.1"}
        datalevin/datalevin                      {:mvn/version "1.2.7"}
        org.commonmark/commonmark                {:mvn/version "0.31.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.31.0"}}

 ;; Datalevin 在 JDK 17+ 需要開放 nio 內部存取
 :aliases
 {:run {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "knot.main"]}

  :dev {:extra-paths ["dev" "test" "test-resources"]
        :extra-deps {integrant/repl {:mvn/version "0.5.1"}}
        :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"
                   "-XX:-OmitStackTraceInFastThrow"]}

  ;; 與 :dev 併用：clojure -M:dev:nrepl，啟動時自動執行 (user/go)
  :nrepl {:extra-deps {nrepl/nrepl       {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.63.1"}}
          :main-opts ["-e" "(try (user/go) (catch Throwable e (println \"(user/go) 失敗：\" (ex-message e))))"
                      "-m" "nrepl.cmdline"
                      "--port" "7888"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}

  :test {:extra-paths ["test" "test-resources"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "5e91ee0"}}
         :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                    "--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; 前端：shadow-cljs.edn 以 :deps {:aliases [:cljs]} 讀取
  :cljs {:extra-paths ["src/cljs" "test"]
         :extra-deps {thheller/shadow-cljs    {:mvn/version "3.5.7"}
                      no.cjohansen/replicant {:mvn/version "2026.07.1"}
                      no.cjohansen/nexus     {:mvn/version "2026.08.1"}}}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.20"}}
         :main-opts ["-m" "clj-kondo.main"]}}}
