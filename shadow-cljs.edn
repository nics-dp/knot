{:deps {:aliases [:cljs]}

 :nrepl {:port 7889}

 :builds
 {:app {:target :browser
        :output-dir "resources/public/js"
        :asset-path "/js"
        :modules {:main {:init-fn knot.app/init}}
        :devtools {:after-load knot.app/reload!}}

  :test {:target :node-test
         :output-to "target/cljs-test/test.js"
         :ns-regexp "-test$"
         :autorun true}}}
